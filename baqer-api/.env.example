NODE_ENV=development
PORT=3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/qarep

# JWT - غيّر هذه القيم في الإنتاج. استخدم علامات اقتباس إذا احتوت على #
JWT_ACCESS_SECRET="your-access-secret-min-32-chars"
JWT_REFRESH_SECRET="your-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN=90d
JWT_REFRESH_EXPIRES_IN=100d

# Bcrypt
BCRYPT_ROUNDS=12

# Rate limit — عام لكل مستخدم (لا يشمل /api/auth)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
# تسجيل الدخول: محاولات فاشلة لكل رقم هاتف في النافذة (15 دقيقة)
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_ENABLED=true

# Firebase Admin SDK - المسار الكامل لملف اعتماد Firebase (مطلوب للإشعارات)
# مثال: /path/to/your-project-firebase-adminsdk-xxxxx.json
FIREBASE_CREDENTIALS_PATH=
# أو استخدم GOOGLE_APPLICATION_CREDENTIALS بنفس المسار

# Telegram notifications (اختياري - اتركه فارغاً لتعطيل الإشعارات)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# - db  : من قاعدة البيانات (الداشبورد) [الافتراضي]
# - env : من متغيرات البيئة أدناه
PLATFORM_SETTINGS_SOURCE=db
PLATFORM_DELIVERY_ENABLED=true
PLATFORM_DELIVERY_PAUSE_REASON=

# إعدادات تحديث التطبيق
APP_MINIMUM_VERSION=1.0.0
APP_STORE_URL=https://play.google.com/store/apps/details?id=com.your.package
APP_FORCE_UPDATE=false

# CORS - في الإنتاج حدد النطاقات المسموحة مفصولة بفاصلة (نفس دومين الواجهة والـ API خلف nginx)
# مثال: https://dentalapp.compassaccuracy.com,http://dentalapp.compassaccuracy.com
CORS_ORIGINS=

# خادم المكالمات (WebRTC signaling) — يُرجع لعميلات التطبيق عبر GET /api/calls/config (بعد تسجيل الدخول)
# خادم Go مباشرة (بدون TLS): ws://HOST:9090/ws — لا تستخدم wss:// إلا مع TLS أمام الخادم (nginx إلخ)
# خلف nginx مع TLS: wss://calls.example.com/ws
CALL_SIGNALING_WS_URL=
# خوادم ICE/TURN لـ WebRTC (مصفوفة JSON). إذا تُرك فارغاً يُستخدم STUN الافتراضي في التطبيق.
# مثال: [{"urls":"stun:stun.l.google.com:19302"}]
CALL_WEBRTC_ICE_JSON=
